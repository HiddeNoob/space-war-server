{
  "name": "space-war-client",
  "version": "0.0.2",
  "private": true,
  "description": "TypeScript sources for the Space War web client. Compiled by Maven into target/classes/static/scripts/.",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=../resources/static/scripts/main.js --format=esm && cp index.html ../resources/static/index.html",
    "watch": "esbuild src/main.ts --bundle --outfile=../../../target/classes/static/scripts/main.js --format=esm --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@types/pako": "^2.0.4",
    "pako": "^2.1.0"
  }
}
